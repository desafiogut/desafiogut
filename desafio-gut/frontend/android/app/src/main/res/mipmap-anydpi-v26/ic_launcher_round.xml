<?xml version="1.0" encoding="utf-8"?>
<!-- UTAC123 (R18, pedido do operador) — ícone ADAPTATIVO (Android 8+).
     Sem este ficheiro o launcher usava o PNG antigo encolhido dentro de uma forma BRANCA.
     A arte (432 px = 108 dp em xxxhdpi) enche a camada com um inset de 8%: a máscara do
     launcher mostra só os 72 dp centrais, e com 0% cortava o topo do cabelo e o martelo.
     Com 8% a forma continua 100% preenchida pela arte e o GUTO aparece inteiro da cabeça
     ao peito. O fundo é o azul-marinho da própria arte (nunca branco). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground"
            android:inset="8%" />
    </foreground>
</adaptive-icon>
